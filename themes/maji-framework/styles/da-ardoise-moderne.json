{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Ardoise moderne",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Fond",
					"color": "#F7F8FA"
				},
				{
					"slug": "contrast",
					"name": "Contraste",
					"color": "#12171F"
				},
				{
					"slug": "primary",
					"name": "Primaire",
					"color": "#2B3A55"
				},
				{
					"slug": "primary-contrast",
					"name": "Contraste primaire",
					"color": "#FFFFFF"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#C77A0A"
				},
				{
					"slug": "accent-contrast",
					"name": "Contraste accent",
					"color": "#1A1206"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#EEF1F5"
				},
				{
					"slug": "surface-alt",
					"name": "Surface alternative",
					"color": "#E1E6EC"
				},
				{
					"slug": "ink",
					"name": "Encre",
					"color": "#1E2530"
				},
				{
					"slug": "ink-muted",
					"name": "Encre atténuée",
					"color": "#5A6472"
				}
			],
			"duotone": [
				{
					"slug": "maji-mono",
					"name": "Acier",
					"colors": [
						"#12171F",
						"#8A97A8"
					]
				},
				{
					"slug": "maji-primary",
					"name": "Ardoise",
					"colors": [
						"#2B3A55",
						"#F7F8FA"
					]
				}
			]
		},
		"custom": {
			"maji": {
				"radius": {
					"sm": "4px",
					"md": "8px",
					"lg": "12px",
					"pill": "999px"
				},
				"shadow": {
					"card": "0 3px 12px rgba(18,23,31,.07)",
					"float": "0 14px 36px rgba(18,23,31,.12)"
				},
				"motion": {
					"duration": "160ms",
					"easing": "cubic-bezier(.2,.8,.2,1)"
				}
			}
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": {
				"operator": "*",
				"increment": 1.6,
				"steps": 7,
				"mediumStep": 1.5,
				"unit": "rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "700",
					"lineHeight": "1.12",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": {
					"radius": "var(--wp--custom--maji--radius--md)"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--sm)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--primary-contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--space-grotesk)",
					"fontWeight": "700"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"width": "3px",
						"style": "solid"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--surface-alt)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			}
		}
	}
}
