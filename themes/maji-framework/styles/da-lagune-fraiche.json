{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Lagune fraîche",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Fond",
					"color": "#F7FBFC"
				},
				{
					"slug": "contrast",
					"name": "Contraste",
					"color": "#0C2A33"
				},
				{
					"slug": "primary",
					"name": "Primaire",
					"color": "#0B6E7A"
				},
				{
					"slug": "primary-contrast",
					"name": "Contraste primaire",
					"color": "#FFFFFF"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#C2451F"
				},
				{
					"slug": "accent-contrast",
					"name": "Contraste accent",
					"color": "#FFFFFF"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#EAF3F4"
				},
				{
					"slug": "surface-alt",
					"name": "Surface alternative",
					"color": "#DCE9EB"
				},
				{
					"slug": "ink",
					"name": "Encre",
					"color": "#1B2E33"
				},
				{
					"slug": "ink-muted",
					"name": "Encre atténuée",
					"color": "#5A6E73"
				}
			],
			"duotone": [
				{
					"slug": "maji-mono",
					"name": "Brume lagunaire",
					"colors": [
						"#0C2A33",
						"#F7FBFC"
					]
				},
				{
					"slug": "maji-primary",
					"name": "Turquoise",
					"colors": [
						"#0B6E7A",
						"#F7FBFC"
					]
				}
			]
		},
		"custom": {
			"maji": {
				"radius": {
					"sm": "8px",
					"md": "14px",
					"lg": "20px",
					"pill": "999px"
				},
				"shadow": {
					"card": "0 6px 20px rgba(11,110,122,.10)",
					"float": "0 18px 44px rgba(11,110,122,.16)"
				},
				"motion": {
					"duration": "200ms",
					"duration-fast": "140ms",
					"reveal": "600ms",
					"easing": "cubic-bezier(.2,.8,.2,1)",
					"easing-emphasized": "cubic-bezier(.16,1,.3,1)",
					"distance": "18px",
					"stagger": "70ms"
				}
			}
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": {
				"operator": "*",
				"increment": 1.7,
				"steps": 7,
				"mediumStep": 1.6,
				"unit": "rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sora)",
					"fontWeight": "600",
					"lineHeight": "1.12",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": {
					"radius": "var(--wp--custom--maji--radius--pill)"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--sm)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--primary-contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sora)",
					"fontWeight": "600"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"width": "3px",
						"style": "solid"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--surface-alt)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			}
		}
	}
}
