{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Solaire minimal",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Fond", "color": "#FDFDFB" },
				{ "slug": "contrast", "name": "Contraste", "color": "#14181C" },
				{ "slug": "primary", "name": "Primaire", "color": "#0E7C66" },
				{ "slug": "primary-contrast", "name": "Contraste primaire", "color": "#FFFFFF" },
				{ "slug": "accent", "name": "Accent", "color": "#F2620F" },
				{ "slug": "accent-contrast", "name": "Contraste accent", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Surface", "color": "#F5F6F4" },
				{ "slug": "surface-alt", "name": "Surface alternative", "color": "#EBEEE9" },
				{ "slug": "ink", "name": "Encre", "color": "#232A30" },
				{ "slug": "ink-muted", "name": "Encre atténuée", "color": "#5F6A72" }
			],
			"duotone": [
				{
					"slug": "maji-mono",
					"name": "Lumière douce",
					"colors": [ "#3A4750", "#FDFDFB" ]
				},
				{
					"slug": "maji-primary",
					"name": "Vert solaire",
					"colors": [ "#0E7C66", "#FDFDFB" ]
				}
			]
		},
		"custom": {
			"maji": {
				"radius": {
					"sm": "10px",
					"md": "18px",
					"lg": "24px",
					"pill": "999px"
				},
				"shadow": {
					"card": "0 2px 8px rgba(20,24,28,.06)",
					"float": "0 12px 32px rgba(20,24,28,.10)"
				},
				"motion": {
					"duration": "180ms",
					"easing": "cubic-bezier(.2,.8,.2,1)"
				}
			}
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": {
				"operator": "*",
				"increment": 1.7,
				"steps": 7,
				"mediumStep": 1.6,
				"unit": "rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sora)",
					"fontWeight": "700",
					"lineHeight": "1.12",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": {
					"radius": "var(--wp--custom--maji--radius--pill)"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--sm)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--primary-contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sora)",
					"fontWeight": "700"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"width": "4px",
						"style": "solid"
					}
				}
			},
			"core/image": {
				"border": { "radius": "var(--wp--custom--maji--radius--lg)" }
			},
			"core/post-featured-image": {
				"border": { "radius": "var(--wp--custom--maji--radius--lg)" }
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var(--wp--preset--color--contrast)",
							"width": "1px"
						}
					}
				}
			}
		}
	}
}
