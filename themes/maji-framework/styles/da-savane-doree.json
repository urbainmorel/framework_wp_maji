{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Savane dorée",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Fond",
					"color": "#FBF6EC"
				},
				{
					"slug": "contrast",
					"name": "Contraste",
					"color": "#2A2114"
				},
				{
					"slug": "primary",
					"name": "Primaire",
					"color": "#3B5233"
				},
				{
					"slug": "primary-contrast",
					"name": "Contraste primaire",
					"color": "#FFFFFF"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#B8791C"
				},
				{
					"slug": "accent-contrast",
					"name": "Contraste accent",
					"color": "#201A0E"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#F3EBDA"
				},
				{
					"slug": "surface-alt",
					"name": "Surface alternative",
					"color": "#E9DEC6"
				},
				{
					"slug": "ink",
					"name": "Encre",
					"color": "#33291A"
				},
				{
					"slug": "ink-muted",
					"name": "Encre atténuée",
					"color": "#6E6146"
				}
			],
			"duotone": [
				{
					"slug": "maji-mono",
					"name": "Herbe sèche",
					"colors": [
						"#2A2114",
						"#C9B48C"
					]
				},
				{
					"slug": "maji-primary",
					"name": "Feuillage",
					"colors": [
						"#3B5233",
						"#FBF6EC"
					]
				}
			]
		},
		"custom": {
			"maji": {
				"radius": {
					"sm": "6px",
					"md": "12px",
					"lg": "18px",
					"pill": "999px"
				},
				"shadow": {
					"card": "0 4px 16px rgba(42,33,20,.08)",
					"float": "0 16px 40px rgba(42,33,20,.14)"
				},
				"motion": {
					"duration": "220ms",
					"easing": "cubic-bezier(.2,.8,.2,1)"
				}
			}
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": {
				"operator": "*",
				"increment": 1.65,
				"steps": 7,
				"mediumStep": 1.7,
				"unit": "rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--nunito-sans)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)",
					"fontWeight": "500",
					"lineHeight": "1.12",
					"letterSpacing": "-0.005em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": {
					"radius": "var(--wp--custom--maji--radius--md)"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--sm)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--primary-contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)",
					"fontWeight": "500"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"width": "3px",
						"style": "solid"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--surface-alt)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			}
		}
	}
}
