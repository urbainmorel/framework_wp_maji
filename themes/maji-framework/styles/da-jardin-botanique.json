{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Jardin botanique",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Fond",
					"color": "#F9F8F3"
				},
				{
					"slug": "contrast",
					"name": "Contraste",
					"color": "#1B2318"
				},
				{
					"slug": "primary",
					"name": "Primaire",
					"color": "#2F5D3A"
				},
				{
					"slug": "primary-contrast",
					"name": "Contraste primaire",
					"color": "#FFFFFF"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#A83D50"
				},
				{
					"slug": "accent-contrast",
					"name": "Contraste accent",
					"color": "#FFFFFF"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#F0F1E9"
				},
				{
					"slug": "surface-alt",
					"name": "Surface alternative",
					"color": "#E4E7DA"
				},
				{
					"slug": "ink",
					"name": "Encre",
					"color": "#26301F"
				},
				{
					"slug": "ink-muted",
					"name": "Encre atténuée",
					"color": "#5C6653"
				}
			],
			"duotone": [
				{
					"slug": "maji-mono",
					"name": "Sous-bois",
					"colors": [
						"#1B2318",
						"#A9B49E"
					]
				},
				{
					"slug": "maji-primary",
					"name": "Feuillage",
					"colors": [
						"#2F5D3A",
						"#F9F8F3"
					]
				}
			]
		},
		"custom": {
			"maji": {
				"radius": {
					"sm": "12px",
					"md": "20px",
					"lg": "28px",
					"pill": "999px"
				},
				"shadow": {
					"card": "0 4px 16px rgba(27,35,24,.08)",
					"float": "0 16px 40px rgba(27,35,24,.14)"
				},
				"motion": {
					"duration": "200ms",
					"easing": "cubic-bezier(.2,.8,.2,1)"
				}
			}
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": {
				"operator": "*",
				"increment": 1.75,
				"steps": 7,
				"mediumStep": 1.7,
				"unit": "rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)",
					"fontWeight": "400",
					"lineHeight": "1.12",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": {
					"radius": "var(--wp--custom--maji--radius--pill)"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--sm)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--primary-contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)",
					"fontWeight": "400"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"width": "3px",
						"style": "solid"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--surface-alt)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			}
		}
	}
}
