{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Terracotta vive",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Fond",
					"color": "#FCF7F3"
				},
				{
					"slug": "contrast",
					"name": "Contraste",
					"color": "#241410"
				},
				{
					"slug": "primary",
					"name": "Primaire",
					"color": "#A83E1F"
				},
				{
					"slug": "primary-contrast",
					"name": "Contraste primaire",
					"color": "#FFFFFF"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#0F7A6B"
				},
				{
					"slug": "accent-contrast",
					"name": "Contraste accent",
					"color": "#FFFFFF"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#F6ECE4"
				},
				{
					"slug": "surface-alt",
					"name": "Surface alternative",
					"color": "#EFDFD3"
				},
				{
					"slug": "ink",
					"name": "Encre",
					"color": "#33231C"
				},
				{
					"slug": "ink-muted",
					"name": "Encre atténuée",
					"color": "#6F5A4F"
				}
			],
			"duotone": [
				{
					"slug": "maji-mono",
					"name": "Argile",
					"colors": [
						"#241410",
						"#C9A99A"
					]
				},
				{
					"slug": "maji-primary",
					"name": "Terre cuite",
					"colors": [
						"#A83E1F",
						"#FCF7F3"
					]
				}
			]
		},
		"custom": {
			"maji": {
				"radius": {
					"sm": "5px",
					"md": "10px",
					"lg": "16px",
					"pill": "999px"
				},
				"shadow": {
					"card": "0 6px 18px rgba(36,20,16,.10)",
					"float": "0 18px 44px rgba(36,20,16,.16)"
				},
				"motion": {
					"duration": "200ms",
					"easing": "cubic-bezier(.2,.8,.2,1)"
				}
			}
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": {
				"operator": "*",
				"increment": 1.7,
				"steps": 7,
				"mediumStep": 1.6,
				"unit": "rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--work-sans)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cormorant-garamond)",
					"fontWeight": "600",
					"lineHeight": "1.12",
					"letterSpacing": "0"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": {
					"radius": "var(--wp--custom--maji--radius--md)"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--sm)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--primary-contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cormorant-garamond)",
					"fontWeight": "600"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"width": "3px",
						"style": "solid"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--surface-alt)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var(--wp--custom--maji--radius--lg)"
				}
			}
		}
	}
}
