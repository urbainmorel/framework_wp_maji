{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "base", "name": "Fond", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Contraste", "color": "#101418" },
				{ "slug": "primary", "name": "Primaire", "color": "#1B3A4B" },
				{ "slug": "primary-contrast", "name": "Contraste primaire", "color": "#FFFFFF" },
				{ "slug": "accent", "name": "Accent", "color": "#B98A1F" },
				{ "slug": "accent-contrast", "name": "Contraste accent", "color": "#141414" },
				{ "slug": "surface", "name": "Surface", "color": "#F6F5F2" },
				{ "slug": "surface-alt", "name": "Surface alternative", "color": "#ECEAE4" },
				{ "slug": "ink", "name": "Encre", "color": "#22262A" },
				{ "slug": "ink-muted", "name": "Encre atténuée", "color": "#585F66" }
			],
			"duotone": [
				{
					"slug": "maji-mono",
					"name": "Monochrome MAJI",
					"colors": [ "#101418", "#F6F5F2" ]
				},
				{
					"slug": "maji-primary",
					"name": "Primaire MAJI",
					"colors": [ "#1B3A4B", "#FFFFFF" ]
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "xs", "name": "XS", "size": "0.8125rem", "fluid": { "min": "0.8125rem", "max": "0.875rem" } },
				{ "slug": "sm", "name": "S", "size": "0.9375rem", "fluid": { "min": "0.9375rem", "max": "1rem" } },
				{ "slug": "md", "name": "M", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "lg", "name": "L", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.5rem" } },
				{ "slug": "xl", "name": "XL", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "2xl", "name": "2XL", "size": "2.375rem", "fluid": { "min": "1.875rem", "max": "2.75rem" } },
				{ "slug": "3xl", "name": "3XL", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "4rem" } }
			],
			"fontFamilies": [
				{
					"slug": "fraunces",
					"name": "Fraunces",
					"fontFamily": "\"Fraunces\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces/fraunces-400.woff2" ] },
						{ "fontFamily": "Fraunces", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces/fraunces-700.woff2" ] }
					]
				},
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "\"Inter\", -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter/inter-400.woff2" ] },
						{ "fontFamily": "Inter", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter/inter-700.woff2" ] }
					]
				},
				{
					"slug": "playfair-display",
					"name": "Playfair Display",
					"fontFamily": "\"Playfair Display\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Playfair Display", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-display/playfair-display-400.woff2" ] },
						{ "fontFamily": "Playfair Display", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-display/playfair-display-700.woff2" ] }
					]
				},
				{
					"slug": "source-sans-3",
					"name": "Source Sans 3",
					"fontFamily": "\"Source Sans 3\", -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Source Sans 3", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-sans-3/source-sans-3-400.woff2" ] },
						{ "fontFamily": "Source Sans 3", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/source-sans-3/source-sans-3-700.woff2" ] }
					]
				},
				{
					"slug": "sora",
					"name": "Sora",
					"fontFamily": "\"Sora\", -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Sora", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/sora/sora-400.woff2" ] },
						{ "fontFamily": "Sora", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/sora/sora-700.woff2" ] }
					]
				},
				{
					"slug": "cormorant-garamond",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond/cormorant-garamond-400.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond/cormorant-garamond-700.woff2" ] }
					]
				},
				{
					"slug": "work-sans",
					"name": "Work Sans",
					"fontFamily": "\"Work Sans\", -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Work Sans", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/work-sans/work-sans-400.woff2" ] },
						{ "fontFamily": "Work Sans", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/work-sans/work-sans-700.woff2" ] }
					]
				},
				{
					"slug": "lora",
					"name": "Lora",
					"fontFamily": "\"Lora\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Lora", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora/lora-400.woff2" ] },
						{ "fontFamily": "Lora", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora/lora-700.woff2" ] }
					]
				},
				{
					"slug": "nunito-sans",
					"name": "Nunito Sans",
					"fontFamily": "\"Nunito Sans\", -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Nunito Sans", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-sans/nunito-sans-400.woff2" ] },
						{ "fontFamily": "Nunito Sans", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-sans/nunito-sans-700.woff2" ] }
					]
				},
				{
					"slug": "space-grotesk",
					"name": "Space Grotesk",
					"fontFamily": "\"Space Grotesk\", -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Space Grotesk", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/space-grotesk/space-grotesk-400.woff2" ] },
						{ "fontFamily": "Space Grotesk", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/space-grotesk/space-grotesk-700.woff2" ] }
					]
				},
				{
					"slug": "ibm-plex-sans",
					"name": "IBM Plex Sans",
					"fontFamily": "\"IBM Plex Sans\", -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans/ibm-plex-sans-400.woff2" ] },
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans/ibm-plex-sans-700.woff2" ] }
					]
				}
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingScale": {
				"operator": "*",
				"increment": 1.6,
				"steps": 7,
				"mediumStep": 1.5,
				"unit": "rem"
			}
		},
		"dimensions": {
			"minHeight": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"maji": {
				"radius": {
					"sm": "4px",
					"md": "12px",
					"lg": "20px",
					"pill": "999px"
				},
				"shadow": {
					"card": "0 8px 24px rgba(0,0,0,.08)",
					"float": "0 16px 48px rgba(0,0,0,.14)"
				},
				"motion": {
					"duration": "200ms",
					"duration-fast": "140ms",
					"reveal": "600ms",
					"easing": "cubic-bezier(.2,.8,.2,1)",
					"easing-emphasized": "cubic-bezier(.16,1,.3,1)",
					"distance": "20px",
					"stagger": "70ms"
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--md)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--3xl)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--2xl)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--primary-contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontWeight": "700"
				},
				"border": {
					"radius": "var(--wp--custom--maji--radius--md)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--accent-contrast)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--accent-contrast)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--ink-muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--xs)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)",
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--lg)"
				},
				"elements": {
					"link": {
						"color": { "text": "inherit" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--sm)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--surface-alt)" },
				"border": { "width": "1px" }
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"width": "3px",
						"style": "solid"
					}
				},
				"typography": { "fontFamily": "var(--wp--preset--font-family--fraunces)" }
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)",
					"fontSize": "var(--wp--preset--font-size--xl)"
				},
				"color": { "text": "var(--wp--preset--color--contrast)" }
			},
			"core/image": {
				"border": { "radius": "var(--wp--custom--maji--radius--md)" }
			},
			"core/post-featured-image": {
				"border": { "radius": "var(--wp--custom--maji--radius--md)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header-01", "title": "En-tête 01 — transparent", "area": "header" },
		{ "name": "header-02", "title": "En-tête 02 — solide", "area": "header" },
		{ "name": "header-03", "title": "En-tête 03 — centré", "area": "header" },
		{ "name": "header-04", "title": "En-tête 04 — split", "area": "header" },
		{ "name": "footer-01", "title": "Pied de page 01 — complet", "area": "footer" },
		{ "name": "footer-02", "title": "Pied de page 02 — minimal", "area": "footer" },
		{ "name": "footer-03", "title": "Pied de page 03 — éditorial", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-libre", "title": "Page libre (sans titre)", "postTypes": [ "page" ] }
	]
}
