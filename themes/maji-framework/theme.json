{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Fond", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Contraste", "color": "#111111" },
				{ "slug": "primary", "name": "Primaire", "color": "#1B3A4B" },
				{ "slug": "primary-contrast", "name": "Contraste primaire", "color": "#FFFFFF" },
				{ "slug": "accent", "name": "Accent", "color": "#C9A227" },
				{ "slug": "accent-contrast", "name": "Contraste accent", "color": "#141414" },
				{ "slug": "surface", "name": "Surface", "color": "#F6F5F2" },
				{ "slug": "surface-alt", "name": "Surface alternative", "color": "#ECEAE4" },
				{ "slug": "ink", "name": "Encre", "color": "#22262A" },
				{ "slug": "ink-muted", "name": "Encre atténuée", "color": "#5C646B" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": []
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		}
	},
	"templateParts": [
		{ "name": "header-01", "title": "En-tête 01 — transparent", "area": "header" },
		{ "name": "header-02", "title": "En-tête 02 — solide", "area": "header" },
		{ "name": "header-03", "title": "En-tête 03 — centré", "area": "header" },
		{ "name": "header-04", "title": "En-tête 04 — split", "area": "header" },
		{ "name": "footer-01", "title": "Pied de page 01 — complet", "area": "footer" },
		{ "name": "footer-02", "title": "Pied de page 02 — minimal", "area": "footer" },
		{ "name": "footer-03", "title": "Pied de page 03 — éditorial", "area": "footer" }
	]
}
