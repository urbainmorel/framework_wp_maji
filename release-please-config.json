{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "bump-minor-pre-major": false,
      "bump-patch-for-minor-pre-major": false,
      "draft": false,
      "prerelease": false,
      "extra-files": [
        "plugins/maji-core/maji-core.php",
        "themes/maji-framework/style.css"
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Ajouté" },
    { "type": "fix", "section": "Corrigé" },
    { "type": "perf", "section": "Performances" },
    { "type": "revert", "section": "Retours arrière" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Refactorisations" },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "Intégration continue", "hidden": true },
    { "type": "chore", "section": "Divers", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ]
}
