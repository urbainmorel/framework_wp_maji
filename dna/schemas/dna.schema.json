{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/urbainmorel/framework_wp_maji/dna/schemas/dna.schema.json",
	"title": "MAJI — ADN de site",
	"description": "Fichier d'identité d'un site client MAJI (schéma maji-dna/1).",
	"type": "object",
	"required": [ "schema", "meta", "identity", "design", "structure", "content" ],
	"additionalProperties": false,
	"properties": {
		"schema": { "const": "maji-dna/1" },
		"meta": {
			"type": "object",
			"required": [ "site_slug", "client", "created_at" ],
			"additionalProperties": false,
			"properties": {
				"site_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,60}$" },
				"client": { "type": "string", "minLength": 1 },
				"created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
			}
		},
		"identity": {
			"type": "object",
			"required": [ "name", "type", "phone", "whatsapp" ],
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"type": { "enum": [ "hotel", "restaurant", "mixte" ] },
				"phone": { "type": "string", "pattern": "^\\+[1-9]\\d{6,14}$" },
				"whatsapp": { "type": "string", "pattern": "^\\+[1-9]\\d{6,14}$" },
				"email": { "type": "string" },
				"address": {
					"type": "object",
					"properties": {
						"street": { "type": "string" },
						"district": { "type": "string" },
						"city": { "type": "string" },
						"country": { "type": "string", "pattern": "^[A-Z]{2}$" }
					}
				},
				"hours": { "type": "object" },
				"currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
				"locale": { "type": "string" },
				"socials": { "type": "object" },
				"features": { "type": "object" },
				"delivery_zones": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [ "name", "fee" ],
						"properties": {
							"name": { "type": "string", "minLength": 1 },
							"fee": { "type": "integer", "minimum": 0 }
						}
					}
				}
			}
		},
		"integrations": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"n8n_order_url": { "type": "string" },
				"n8n_reservation_url": { "type": "string" }
			}
		},
		"design": {
			"type": "object",
			"required": [ "da", "font_pair" ],
			"additionalProperties": false,
			"properties": {
				"da": { "enum": [ "da-editorial-sombre", "da-solaire-minimal", "da-artisanal-texture" ] },
				"font_pair": { "enum": [ "fp-01", "fp-02", "fp-03", "fp-04", "fp-05", "fp-06" ] },
				"palette": {
					"type": "object",
					"additionalProperties": false,
					"patternProperties": {
						"^(base|contrast|primary|primary-contrast|accent|accent-contrast|surface|surface-alt|ink|ink-muted)$": {
							"type": "string",
							"pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
						}
					}
				},
				"radius_scale": { "enum": [ "sm", "md", "lg" ] },
				"spacing_mood": { "enum": [ "compact", "normal", "aere" ] },
				"image_treatment": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"hero_ratio": { "enum": [ "16:9", "4:3", "21:9", "3:2" ] },
						"card_ratio": { "enum": [ "4:3", "1:1", "3:4", "16:9" ] },
						"overlay": { "enum": [ "none", "primary", "dark" ] },
						"duotone": { "type": "boolean" }
					}
				}
			}
		},
		"structure": {
			"type": "object",
			"required": [ "header", "footer", "nav_vocabulary", "pages" ],
			"additionalProperties": false,
			"properties": {
				"header": { "enum": [ "header-01", "header-02", "header-03", "header-04" ] },
				"footer": { "enum": [ "footer-01", "footer-02", "footer-03" ] },
				"nav_vocabulary": { "type": "string", "minLength": 1 },
				"pages": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": [ "slug", "title", "sections" ],
						"additionalProperties": false,
						"properties": {
							"slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
							"title": { "type": "string", "minLength": 1 },
							"sections": {
								"type": "array",
								"minItems": 1,
								"items": { "type": "string", "pattern": "^maji/[a-z0-9-]+$" }
							}
						}
					}
				}
			}
		},
		"content": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"tone": { "enum": [ "premium", "familial", "local", "minimal" ] },
				"facts": { "type": "object" },
				"texts": { "type": "object" },
				"seed": { "type": "string" }
			}
		}
	}
}
