<?xml version="1.0"?>
<ruleset name="MAJI">
	<description>Coding standards for the MAJI WordPress framework.</description>

	<file>plugins/maji-core/maji-core.php</file>
	<file>plugins/maji-core/uninstall.php</file>
	<file>plugins/maji-core/src</file>
	<file>plugins/maji-core/blocks</file>
	<file>themes/maji-framework/functions.php</file>
	<file>themes/maji-framework/inc</file>
	<file>themes/maji-framework/patterns</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Short array syntax is the project standard. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- PSR-4 file naming is used in src/ (class-*.php not applicable). -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- File comments duplicated by class docblocks in PSR-4 files. -->
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="maji-core"/>
				<element value="maji-framework"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_maji"/>
				<element value="edit_products"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="maji"/>
				<element value="MAJI"/>
			</property>
		</properties>
	</rule>
</ruleset>
